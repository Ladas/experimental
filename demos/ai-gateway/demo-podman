#!/usr/bin/env bash
# The AI gateway demo on podman. ./demo-docker is the same thing on docker.
#
#   ./demo-podman up ollama       local model, no key, no cost
#   ./demo-podman up openai       hosted; asks once for the key
#   ./demo-podman verify          run the checks
#   ./demo-podman urls            print the dashboard links
#   ./demo-podman down            stop and clean up
#   ./demo-podman forget openai   delete the stored key
#
# Providers: ollama, openai, anthropic, openrouter -- one configs/<name>.yaml
# each. See docs/podman.md for the same steps run by hand.
set -euo pipefail

cd "$(dirname "$0")"
# ./demo-docker execs this with the engine already chosen; anything else is
# podman. It is never guessed from what happens to be installed: on a machine
# with both, starting the stack on one and looking for it on the other is a
# frustrating ten minutes.
ENGINE="${DEMO_ENGINE:-podman}"
DEMO_CMD="./demo-${ENGINE}"
# shellcheck source=scripts/demo-lib.sh
. scripts/demo-lib.sh

STATE_FILE=".demo-compose"

# Overridable so this can run alongside the KIND target, which holds host ports
# of its own.
GW_PORT="${GATEWAY_PORT:-8080}"
ADMIN="${ADMIN_PORT:-9901}"
PERSES="${PERSES_PORT:-8081}"
PROM="${PROMETHEUS_PORT:-9090}"
TEMPO="${TEMPO_PORT:-3200}"

compose_cmd() {
  local -a files=(-f compose.yaml)
  # Native Linux docker does not resolve host.docker.internal. Applying the
  # overlay everywhere would break Rancher Desktop, where the same entry
  # resolves to the VM and the gateway answers 502.
  if [ "$(uname -s)" = "Linux" ]; then
    files+=(-f compose.linux.yaml)
  fi
  (cd compose && PRAXIS_PROVIDER="${PROVIDER}" "${ENGINE}" compose "${files[@]}" "$@")
}

up() {
  require_engine "${ENGINE}"
  ensure_image "${ENGINE}"
  ensure_ollama
  ensure_key
  printf '%s\n' "${PROVIDER}" > "${STATE_FILE}"

  say "starting on ${ENGINE} compose, provider ${PROVIDER}"
  compose_cmd up -d
  printf '  waiting for the gateway'
  for _ in $(seq 1 60); do
    # The admin health endpoint, not the proxy port: GET / on the proxy is
    # forwarded upstream, and a hosted provider answers it 401, which says
    # nothing about whether praxis is ready.
    if curl --fail --silent --max-time 2 --output /dev/null "http://localhost:${ADMIN}/healthy"; then
      printf ' ok\n'
      print_urls "${GW_PORT}" "${ADMIN}" "${PERSES}" "${PROM}"
      return 0
    fi
    printf '.'
    sleep 2
  done
  printf '\n'
  die "gateway did not come up. Logs: (cd compose && ${ENGINE} compose logs praxis)"
}

down() {
  require_engine "${ENGINE}"
  say "stopping the compose stack"
  compose_cmd down -v
  rm -f "${STATE_FILE}"
}

usage() {
  cat <<'USAGE'
Usage: ./demo-podman <command> [provider]      (or ./demo-docker, for docker)

  up [provider]     start the stack; provider defaults to ollama
  verify            run the checks against whatever is up
  urls              print the dashboard links
  down              stop and clean up
  forget <provider> delete that provider's stored API key

Providers: ollama, openai, anthropic, openrouter.
The provider is remembered, so verify/urls/down take no arguments.
USAGE
}

cmd="${1:-}"
shift || true

provider="${1:-}"
if [ -z "${provider}" ] && [ -f "${STATE_FILE}" ]; then
  read -r provider < "${STATE_FILE}" || true
fi

case "${cmd}" in
  forget)
    [ -n "${provider}" ] || die "which provider? e.g. ./demo-podman forget openai"
    resolve_provider "${provider}"
    var="$(key_var_for "${PROVIDER}")"
    [ -n "${var}" ] || die "${PROVIDER} does not use an API key"
    forget_key "${var}"
    exit 0
    ;;
esac

resolve_provider "${provider}"

case "${cmd}" in
  up) up ;;
  verify) run_verify "${GW_PORT}" "${PROM}" "${TEMPO}" ;;
  urls) print_urls "${GW_PORT}" "${ADMIN}" "${PERSES}" "${PROM}" ;;
  down) down ;;
  '' | -h | --help | help) usage ;;
  *)
    usage
    exit 1
    ;;
esac
